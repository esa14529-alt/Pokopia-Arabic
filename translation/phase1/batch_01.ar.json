  "ar": "مهلًا، لا عليك!"
 },
 {
  "id": 1416,
  "ar": "ظننت أنني سمعت أصواتًا"
 },
 {
  "id": 1417,
  "ar": "أنا لست إنسانًا، يو"
 },
 {
  "id": 1418,
  "ar": "كنت مذهلًا!"
 },
 {
  "id": 1419,
  "ar": "اه... أظن ذلك؟ ربما؟"
 },
 {
  "id": 1420,
  "ar": "كلا! أشعر أنني بخير!"
 },
 {
  "id": 1421,
  "ar": "ندور وندور وندور..."
 },
 {
  "id": 1422,
  "ar": "أقلّدك تمامًا"
 },
 {
  "id": 1423,
  "ar": "لا، لا أظن ذلك"
 },
 {
  "id": 1424,
  "ar": "يعجبني تفاؤلك"
 },
 {
  "id": 1425,
  "ar": "لا أدري إن كان هذا صحيحًا..."
 },
 {
  "id": 1426,
  "ar": "اهدأ قليلًا"
 },
 {
  "id": 1427,
  "ar": "أجمم! ممم مممم!"
 },
 {
  "id": 1428,
  "ar": "كلاكما رائع جدًا"
 },
 {
  "id": 1429,
  "ar": "لنهدأ جميعًا أولًا..."
 },
 {
  "id": 1430,
  "ar": "ربما وحل..."
 },
 {
  "id": 1431,
  "ar": "لا بد أنها قمامة!"
 },
 {
  "id": 1432,
  "ar": "أوه، اه، لا أدري..."
 },
 {
  "id": 1433,
  "ar": "الأعراف، أظن"
 },
 {
  "id": 1434,
  "ar": "العُرف بلا شك"
 },
 {
  "id": 1435,
  "ar": "سماء مرصعة بالنجوم"
 },
 {
  "id": 1436,
  "ar": "سماء زرقاء"
 },
 {
  "id": 1437,
  "ar": "آه، مخيف!"
 },
 {
  "id": 1438,
  "ar": "أوه، لطيف!"
 },
 {
  "id": 1439,
  "ar": "اه... لم أكن أشاهد..."
 }
